{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "PORT=18899 BASE_PATH=/ pnpm --filter @workspace/myvault-web run build",
  "outputDirectory": "artifacts/myvault-web/dist/public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
